GROQ_API_KEY=YOUR_GROQ_API_KEY
HF_TOKEN=YOUR_HUGGING_FACE_READ_TOKEN
HF_HOME=.hf_cache
GROQ_MODEL=llama-3.1-8b-instant
API_TITLE=Citadel RAG API
API_DESCRIPTION=Study assistant backed by a local RAG pipeline.
API_VERSION=2.0.0
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_PATH=citadel.db
STATIC_DIR=static
STUDY_PROMPTS_PATH=prompts/study_tools.txt
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_COLLECTION_NAME=citadel_local_minilm
MIN_SIMILARITY=0.25
LLM_MAX_RETRIES=2
INGESTION_BATCH_SIZE=50
INGESTION_MAX_RETRIES=8
INGESTION_MIN_RETRY_WAIT_SECONDS=60
FILE_IO_WORKERS=4
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_LOCK_RETRIES=3
SQLITE_RETRY_DELAY_SECONDS=0.05
QUERY_CACHE_SIZE=128
LOAD_PIPELINE_IN_BACKGROUND=true